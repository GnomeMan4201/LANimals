  "product": "LANimals",
  "version": "2.1.0",
  "updated": "2026-08-14",
  "site_contract": "site_capabilities.json",
  "status_definitions": {
    "implemented_tested": "Implemented in the supported runtime and covered by automated contract tests.",
    "implemented_local_runtime": "Implemented, but meaningful execution requires a self-hosted Linux runtime, local interfaces, system tools, or optional credentials.",
