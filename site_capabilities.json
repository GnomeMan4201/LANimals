{
  "schema_version": 1,
  "product": "LANimals",
  "product_version": "2.1.0",
  "authority": {
    "capability_manifest": "capabilities.json",
    "browser_contract": "docs/BROWSER_RUNTIME_CONTRACT.md",
    "rule": "If a site control cannot be mapped to an operation in this file and a capability in capabilities.json, it must not be presented as operational."
  },
  "surfaces": {
    "hosted_site": {
      "mode": "representative_workflow",
      "network_access": false,
      "api_connection": "none",
      "persistence": "in_memory_page_session",
      "required_badge": "REPRESENTATIVE / NO LIVE LAN ACCESS",
      "may": [
        "render representative inventory, graph, events, risk, baseline, report, and investigation workflows",
        "filter, search, select, sort, branch, and inspect representative data",
        "explain which operations become live in the self-hosted appliance"
      ],
      "must_not": [
        "claim to scan the visitor LAN",
        "claim live ARP, nmap, service, CVE, watchdog, anomaly, VirusTotal, or trap execution",
        "claim representative state is persisted as LANimals evidence",
        "simulate a successful live mutation without an explicit representative label",
        "expose an operating-system shell"
      ]
    },
    "self_hosted_web": {
      "mode": "operational",
      "origin": "http://127.0.0.1:8080 by default",
      "api_connection": "same_origin_local_runtime",
      "persistence": "XDG local state",
      "scope": "explicitly approved private CIDR",
      "mutation_header": "X-LANimals-Operator: 1",
      "system_shell": false
    }
  },
  "site_rules": {
    "page_load": "read_only",
    "active_collection": "explicit_operator_action_only",
    "success_reporting": "A live action is successful only after the local API reports success; partial success must remain visibly partial.",
    "hosted_fallback": "If live runtime is unavailable, keep the control representative/disabled; never silently substitute fabricated live data.",
    "empty_state": "Show an honest empty state when no local evidence exists.",
    "scope_visibility": "Live network acquisition controls must display or reference the approved CIDR/host target before execution."
  },
  "operations": [
    {
      "id": "runtime-health",
      "capability_id": "runtime-boundary",
      "label": "Runtime health",
      "local_runtime": {"supported": true, "method": "GET", "route": "/api/health", "target": "none", "operator_header_required": false, "async_job": false, "persistence": "none", "external_network_dependency": false},
      "hosted_site": {"behavior": "representative_status_only", "live_network_effect": false},
      "failure_contract": "surface_error_and_preserve_previous_state"
    },
    {
      "id": "approved-scope",
      "capability_id": "runtime-boundary",
      "label": "Approved scope",
